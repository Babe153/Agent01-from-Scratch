API_KEY=
MODEL=
BASE_URL=
TAVILY_API_KEY=
AGENT_CONTEXT_TOKEN_LIMIT=400000
#命令默认超时与最大允许超时，单位为秒
AGENT_BASH_DEFAULT_TIMEOUT_SECONDS=120
AGENT_BASH_MAX_TIMEOUT_SECONDS=600
#超过此字符数的完整输出保存到日志文件
AGENT_BASH_MAX_OUTPUT_CHARS=6000
#留空时读取当前任务工作区里的 .Agent01.env
AGENT_BASH_ENV_FILE=
#进度保存模式：light（摘要）、strict（含状态和消息）、off（关闭）
AGENT_CHECKPOINT_MODE=light
